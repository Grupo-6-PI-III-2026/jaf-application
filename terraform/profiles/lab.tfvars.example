# ============================================================
# Perfil Learner Lab (conta de estudante) — mantém o comportamento original.
# Uso: copie para profiles/lab.tfvars e rode:
#   terraform workspace select default
#   terraform plan -var-file=profiles/lab.tfvars
# Segredos (db_password, ghcr_token, jwt_secret...) continuam no terraform.tfvars.
# ============================================================

use_lab_role        = true
allowed_account_ids = []

instance_type    = "t3.micro"
root_volume_size = 30

frontend_asg = { min_size = 2, desired_capacity = 2, max_size = 4 }
backend_asg  = { min_size = 2, desired_capacity = 2, max_size = 4 }
ocr_asg      = { min_size = 2, desired_capacity = 2, max_size = 4 }

single_nat_gateway = false
rds_multi_az       = true

# Diagnóstico temporário: true abre 8080/22 ao mundo e dá IP público ao backend.
# Volte para false depois de validar.
backend_public_access = true
